{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurel-academy-platform",
  "main": "./worker.ts",
  "compatibility_date": "2025-04-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
